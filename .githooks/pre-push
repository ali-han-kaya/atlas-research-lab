#!/bin/sh
# Push edilecek YENI commit'ler taranir; eski gecmis yalniz uyari olarak sayilir.
durum=0
uzak_ad="$1"
while read yerel_ref yerel_sha uzak_ref uzak_sha; do
  case "$yerel_sha" in 0000000000000000000000000000000000000000) continue ;; esac
  python3 tools/sir_kapisi.py --push "$yerel_sha" "$uzak_sha" "${uzak_ad:-origin}" || durum=1
done
exit $durum
