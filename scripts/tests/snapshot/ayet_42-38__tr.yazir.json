{"code":200,"status":"OK","data":{"number":4310,"text":"Onlar, Rablerinin davetini kabul ederler ve namazı dosdoğru kılarlar. Onların işleri de kendi aralarında bir istişare iledir. Kendilerine verdiğimiz rızıktan onlar Allah yolunda harcarlar.","edition":{"identifier":"tr.yazir","language":"tr","name":"Elmalılı Hamdi Yazır","englishName":"Elmalili Hamdi Yazir","format":"text","type":"translation","direction":"ltr"},"surah":{"number":42,"name":"سُورَةُ الشُّورَىٰ","englishName":"Ash-Shura","englishNameTranslation":"Consultation","numberOfAyahs":53,"revelationType":"Meccan"},"numberInSurah":38,"juz":25,"manzil":6,"page":487,"ruku":422,"hizbQuarter":195,"sajda":false}}