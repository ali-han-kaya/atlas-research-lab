{"code":200,"status":"OK","data":{"number":1991,"text":"Şüphesiz ki Allah, size adaleti, iyilik yapmayı ve yakınlara bakmayı emreder; hayasızlıktan, fenalıktan ve azgınlıktan nehyeder. Öğüt almanız için size böyle öğüt verir.","edition":{"identifier":"tr.yazir","language":"tr","name":"Elmalılı Hamdi Yazır","englishName":"Elmalili Hamdi Yazir","format":"text","type":"translation","direction":"ltr"},"surah":{"number":16,"name":"سُورَةُ النَّحۡلِ","englishName":"An-Nahl","englishNameTranslation":"The Bee","numberOfAyahs":128,"revelationType":"Meccan"},"numberInSurah":90,"juz":14,"manzil":3,"page":277,"ruku":236,"hizbQuarter":111,"sajda":false}}