{"code":200,"status":"OK","data":{"number":3486,"text":"Evladım, namazı hakkıyla ifa et, iyiliği yay, kötülüğü de önlemeye çalış, ve başına gelen sıkıntılara sabret.Çünkü bunlar azim ve kararlılık gerektiren işlerdendir.","edition":{"identifier":"tr.yildirim","language":"tr","name":"Suat Yıldırım","englishName":"Suat Yildirim","format":"text","type":"translation","direction":"ltr"},"surah":{"number":31,"name":"سُورَةُ لُقۡمَانَ","englishName":"Luqman","englishNameTranslation":"Luqman","numberOfAyahs":34,"revelationType":"Meccan"},"numberInSurah":17,"juz":21,"manzil":5,"page":412,"ruku":356,"hizbQuarter":164,"sajda":false}}