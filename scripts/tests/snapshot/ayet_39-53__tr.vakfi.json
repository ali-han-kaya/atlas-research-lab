{"code":200,"status":"OK","data":{"number":4111,"text":"De ki: Ey kendi nefisleri aleyhine haddi aşan kullarım! Allah'ın rahmetinden ümit kesmeyin! Çünkü Allah bütün günahları bağışlar. Şüphesiz ki O, çok bağışlayan, çok esirgeyendir.","edition":{"identifier":"tr.vakfi","language":"tr","name":"Diyanet Vakfı","englishName":"Diyanet Vakfi","format":"text","type":"translation","direction":"ltr"},"surah":{"number":39,"name":"سُورَةُ الزُّمَرِ","englishName":"Az-Zumar","englishNameTranslation":"The Groups","numberOfAyahs":75,"revelationType":"Meccan"},"numberInSurah":53,"juz":24,"manzil":6,"page":464,"ruku":401,"hizbQuarter":186,"sajda":false}}