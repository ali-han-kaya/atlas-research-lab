{"code":200,"status":"OK","data":{"number":3486,"text":"Ey oğulcağızım, namaz kıl, iyiliği emret, kötülükten vazgeçirmeye çalış halkı ve bu hususta uğradığın sıkıntılara dayan; şüphe yok ki bunlar, kesin olarak yapılması gereken işlerdendir.","edition":{"identifier":"tr.golpinarli","language":"tr","name":"Abdulbakî Gölpınarlı","englishName":"Abdulbaki Golpinarli","format":"text","type":"translation","direction":"ltr"},"surah":{"number":31,"name":"سُورَةُ لُقۡمَانَ","englishName":"Luqman","englishNameTranslation":"Luqman","numberOfAyahs":34,"revelationType":"Meccan"},"numberInSurah":17,"juz":21,"manzil":5,"page":412,"ruku":356,"hizbQuarter":164,"sajda":false}}