{"code":200,"status":"OK","data":{"number":1991,"text":"Muhakkak ki Allah, adaleti, iyiliği, akrabaya yardım etmeyi emreder, çirkin işleri, fenalık ve azgınlığı da yasaklar. O, düşünüp tutasınız diye size öğüt veriyor.","edition":{"identifier":"tr.vakfi","language":"tr","name":"Diyanet Vakfı","englishName":"Diyanet Vakfi","format":"text","type":"translation","direction":"ltr"},"surah":{"number":16,"name":"سُورَةُ النَّحۡلِ","englishName":"An-Nahl","englishNameTranslation":"The Bee","numberOfAyahs":128,"revelationType":"Meccan"},"numberInSurah":90,"juz":14,"manzil":3,"page":277,"ruku":236,"hizbQuarter":111,"sajda":false}}