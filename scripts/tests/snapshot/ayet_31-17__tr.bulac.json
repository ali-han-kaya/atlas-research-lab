{"code":200,"status":"OK","data":{"number":3486,"text":"\"Ey oğlum, namazı dosdoğru kıl, ma'rufu emret, münkerden sakındır ve sana isabet eden (musibetler)e karşı sabret. Çünkü bunlar, azmedilmesi gereken işlerdendir.","edition":{"identifier":"tr.bulac","language":"tr","name":"Alİ Bulaç","englishName":"Alİ Bulaç","format":"text","type":"translation","direction":"ltr"},"surah":{"number":31,"name":"سُورَةُ لُقۡمَانَ","englishName":"Luqman","englishNameTranslation":"Luqman","numberOfAyahs":34,"revelationType":"Meccan"},"numberInSurah":17,"juz":21,"manzil":5,"page":412,"ruku":356,"hizbQuarter":164,"sajda":false}}