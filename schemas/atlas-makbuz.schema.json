{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ali-han-kaya/atlas-research-lab/schemas/atlas-makbuz.schema.json",
  "title": "ATLAS doğrulama makbuzu",
  "description": "Her doğrulama komutunun argv'sini, çıkış kodunu ve ham çıktı satırını commit/ağaç kanıtına bağlayan taşınabilir makbuz.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at",
    "commit",
    "tree",
    "tree_sha256",
    "attestation_sha256",
    "command_count",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "ATLAS-MAKBUZ/v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "tree_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "attestation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "command_count": {
      "type": "integer",
      "minimum": 1
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "argv",
        "exit_code",
        "status",
        "raw_line",
        "raw_line_sha256",
        "stdout",
        "stderr",
        "stdout_sha256",
        "stderr_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "exit_code": {
          "type": "integer"
        },
        "status": {
          "type": "string",
          "enum": ["PASS", "FAIL", "ERROR"]
        },
        "raw_line": {
          "type": "string",
          "minLength": 1
        },
        "raw_line_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "stdout": {
          "type": "string",
          "pattern": "^komutlar/[0-9]{2}-[A-Za-z0-9_.-]+\\.stdout\\.txt$"
        },
        "stderr": {
          "type": "string",
          "pattern": "^komutlar/[0-9]{2}-[A-Za-z0-9_.-]+\\.stderr\\.txt$"
        },
        "stdout_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "stderr_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}