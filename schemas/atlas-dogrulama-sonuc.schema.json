{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ali-han-kaya/atlas-research-lab/schemas/atlas-dogrulama-sonuc.schema.json",
  "title": "ATLAS doğrulama sonucu",
  "description": "Bir commit üzerinde koşulan doğrulama komutlarının çıkış kodlarını, bulgu kimliklerini ve SHA-256 dosya manifestini taşıyan taşınabilir sonuç.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at",
    "commit",
    "tree",
    "exit_code",
    "verdict",
    "command_count",
    "attestation_sha256",
    "commands",
    "findings",
    "manifest",
    "package"
  ],
  "properties": {
    "schema": {
      "const": "ATLAS-DOGRULAMA/v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "exit_code": {
      "type": "integer",
      "minimum": 0
    },
    "verdict": {
      "type": "string",
      "enum": ["PASS", "FAIL"]
    },
    "command_count": {
      "type": "integer",
      "minimum": 1
    },
    "attestation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "manifest": {
      "$ref": "#/$defs/manifest"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "manifest_file", "attestation_file", "log_directory"],
      "properties": {
        "format": {
          "const": "directory"
        },
        "manifest_file": {
          "const": "manifest.sha256"
        },
        "attestation_file": {
          "const": "attestation.json"
        },
        "log_directory": {
          "const": "komutlar"
        }
      }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "argv",
        "exit_code",
        "status",
        "duration_ms",
        "stdout_sha256",
        "stderr_sha256",
        "stdout_bytes",
        "stderr_bytes",
        "finding_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "exit_code": {
          "type": "integer"
        },
        "status": {
          "type": "string",
          "enum": ["PASS", "FAIL", "ERROR"]
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "stdout_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "stderr_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "stdout_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "stderr_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "finding_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "commands", "severity"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "severity": {
          "type": "string",
          "enum": ["P0", "P1", "P2", "UNKNOWN"]
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "root_sha256", "files"],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "root_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          }
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mode", "size", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": ["100644", "100755", "120000"]
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
