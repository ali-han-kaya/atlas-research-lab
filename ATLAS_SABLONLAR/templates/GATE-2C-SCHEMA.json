{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ATLAS-GATE-2C-SCHEMA/v1",
  "title": "ATLAS P1-8 Gate-2C request and result",
  "description": "Closed contracts for hash-bound pivotal/high-stakes primary-source verification.",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/result" }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "findingId": {
      "type": "string",
      "pattern": "^HJ-(?:[0-9]{3}|R[0-9]{3}|C[0-9]{3})$"
    },
    "claimClass": {
      "enum": ["primary_source_locator", "other"]
    },
    "provider": {
      "enum": ["CROSSREF_DOI", "NONE"]
    },
    "side": {
      "enum": ["PANEL_MAJORITY", "EVIDENCE_MINORITY"]
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "identifier"],
      "properties": {
        "provider": { "$ref": "#/$defs/provider" },
        "identifier": { "type": "string", "minLength": 1 }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doi", "title", "published_year"],
      "properties": {
        "doi": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "published_year": { "type": "integer", "minimum": 1000, "maximum": 9999 }
      }
    },
    "proposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["side", "expected"],
      "properties": {
        "side": { "$ref": "#/$defs/side" },
        "expected": { "$ref": "#/$defs/expected" }
      }
    },
    "requestItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id", "claim_sha256", "claim_class", "external_bound",
        "locator", "propositions", "classification_evidence_ref"
      ],
      "properties": {
        "finding_id": { "$ref": "#/$defs/findingId" },
        "claim_sha256": { "$ref": "#/$defs/sha256" },
        "claim_class": { "$ref": "#/$defs/claimClass" },
        "external_bound": { "type": "boolean" },
        "locator": { "$ref": "#/$defs/locator" },
        "propositions": {
          "type": "array",
          "maxItems": 2,
          "items": { "$ref": "#/$defs/proposition" }
        },
        "classification_evidence_ref": {
          "type": "string",
          "pattern": "^(?:artifact|source):\\S+$"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "run_id", "panel_sha256", "items"],
      "properties": {
        "schema": { "const": "ATLAS-GATE-2C-REQUEST/v1" },
        "run_id": { "type": "string", "minLength": 1 },
        "panel_sha256": { "$ref": "#/$defs/sha256" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/requestItem" }
        }
      }
    },
    "primaryRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doi", "title", "published_years"],
      "properties": {
        "doi": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "published_years": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1000, "maximum": 9999 }
        }
      }
    },
    "resultItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id", "panel_status", "triggered", "trigger_reasons",
        "provider", "status", "winner_side", "wrong_sides", "http_status",
        "primary_record", "response_sha256"
      ],
      "properties": {
        "finding_id": { "$ref": "#/$defs/findingId" },
        "panel_status": { "type": "string", "minLength": 1 },
        "triggered": { "type": "boolean" },
        "trigger_reasons": {
          "type": "array",
          "items": {
            "enum": ["PIVOTAL_EVIDENCE_DISAGREEMENT", "HIGH_STAKES_PRIMARY_SOURCE_LOCATOR"]
          }
        },
        "provider": { "$ref": "#/$defs/provider" },
        "status": {
          "enum": [
            "PANEL_STATUS_STANDS", "RESOLVED_BY_PRIMARY_SOURCE",
            "BLOCKED_HUMAN_REVIEW_REQUIRED", "HUMAN_REVIEW_REQUIRED"
          ]
        },
        "winner_side": {
          "enum": ["PANEL_MAJORITY", "EVIDENCE_MINORITY", null]
        },
        "wrong_sides": {
          "type": "array",
          "items": { "$ref": "#/$defs/side" }
        },
        "http_status": {
          "type": ["integer", "null"],
          "minimum": 100,
          "maximum": 599
        },
        "primary_record": {
          "oneOf": [
            { "$ref": "#/$defs/primaryRecord" },
            { "type": "null" }
          ]
        },
        "response_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "run_id", "panel_sha256", "request_sha256", "verdict",
        "reason_codes", "network_calls", "retries", "items",
        "dersler_written", "fix_manifest_written"
      ],
      "properties": {
        "schema": { "const": "ATLAS-GATE-2C-RESULT/v1" },
        "run_id": { "type": "string", "minLength": 1 },
        "panel_sha256": { "$ref": "#/$defs/sha256" },
        "request_sha256": { "$ref": "#/$defs/sha256" },
        "verdict": { "enum": ["PASS", "BLOCKED"] },
        "reason_codes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "network_calls": { "type": "integer", "minimum": 0 },
        "retries": { "const": 0 },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resultItem" }
        },
        "dersler_written": { "const": false },
        "fix_manifest_written": { "const": false }
      }
    }
  }
}
